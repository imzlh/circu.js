+// Helper macro for class initialization
+#define TJS_WASM_INIT_CLASS(ctx, ns, name, class_id, class_def, ctor, ctor_len, \
+                            proto_funcs, proto_len, static_funcs, static_len) \
+    do { \
+        JSRuntime *rt = JS_GetRuntime(ctx); \
+        JS_NewClassID(rt, &class_id); \
+        JS_NewClass(rt, class_id, &class_def); \
+        JSValue proto = JS_NewObject(ctx); \
+        JS_SetPropertyFunctionList(ctx, proto, proto_funcs, proto_len); \
+        JS_SetClassProto(ctx, class_id, proto); \
+        JSValue constructor = JS_NewCFunction2(ctx, ctor, name, ctor_len, \
+                                               JS_CFUNC_constructor, 0); \
+        if (static_funcs && static_len > 0) \
+            JS_SetPropertyFunctionList(ctx, constructor, static_funcs, static_len); \
+        JS_DefinePropertyValueStr(ctx, ns, name, constructor, JS_PROP_C_W_E); \
+    } while(0)
+
